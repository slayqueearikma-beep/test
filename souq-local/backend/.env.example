# MarGem API environment — copy to .env and customize

APP_NAME=MarGem API
APP_ENV=development
DEBUG=true

# PostgreSQL (local Docker or Azure Database for PostgreSQL)
DATABASE_URL=postgresql+asyncpg://souq:souq_local_dev@localhost:5432/souq_local

# Security — REQUIRED in production (use Azure Key Vault reference)
JWT_SECRET_KEY=generate-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=10080
AUTH_DEV_BYPASS=true

# Firebase (optional — for Firebase mobile auth)
FIREBASE_CREDENTIALS_PATH=

# Azure Blob Storage (product/seller images)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=margem-media

# CORS — comma-separated origins in production
CORS_ORIGINS=["http://localhost:3000","http://10.0.2.2:8000"]

# Rate limiting
RATE_LIMIT=120/minute
