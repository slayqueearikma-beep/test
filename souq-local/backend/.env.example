# Application
APP_NAME=Souq Local API
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://souq:souq_local_dev@localhost:5432/souq_local

# Firebase (path to service account JSON, or leave empty in dev with AUTH_DEV_BYPASS)
FIREBASE_CREDENTIALS_PATH=
AUTH_DEV_BYPASS=true

# Azure Blob Storage (optional in dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=souq-media

# CORS
CORS_ORIGINS=["*"]

# Morocco default cities for seed data
DEFAULT_CITIES=["Casablanca","Rabat","Marrakech","Fes","Tangier","Agadir","Meknes","Oujda"]
