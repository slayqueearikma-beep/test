# Copy to .env.home and fill in (never commit .env.home)

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_JWT_SECRET_KEY_32CHARS

# local = store images on the laptop (recommended for home). azure = Azure Blob.
STORAGE_BACKEND=local

# Required for local (and for Azure public URLs in the app). Use your laptop LAN IP.
# Example: http://192.168.11.103:8000
PUBLIC_API_URL=http://192.168.11.103:8000
PUBLIC_APP_URL=http://192.168.11.103:8000

# Only needed when STORAGE_BACKEND=azure
# From: terraform -chdir=infra/terraform-storage output -raw storage_connection_string
# Keep the whole value in double quotes (contains ; characters).
AZURE_STORAGE_CONNECTION_STRING=

# Prefer comma-separated hosts (no ports). Starlette strips ports from Host headers.
# Example for laptop IP 192.168.11.103:
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.11.103
CORS_ORIGINS=http://192.168.11.103:8000

# Auth was previously 5/minute and blocked normal register/login retries.
AUTH_RATE_LIMIT=30/minute
RATE_LIMIT=300/minute

# Optional transactional email (password reset / verify). Without SMTP, tokens are logged.
ALLOW_INSECURE_EMAIL_FALLBACK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MarGem <noreply@margem.ma>

API_PORT=8000
