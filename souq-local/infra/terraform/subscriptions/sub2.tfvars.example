# Month 2 — use AFTER sub1 credits are exhausted (destroy sub1 first)
# See subscriptions/MONTHLY-ROTATION.md
# Copy to sub2.tfvars and fill in secrets — never commit sub2.tfvars

subscription_id    = "00000000-0000-0000-0000-000000000002"
subscription_alias = "sub2"

location         = "westeurope"
environment_name = "prod"

postgres_admin_login    = "margemadmin"
postgres_admin_password = "CHANGE_ME_DIFFERENT_PASSWORD"
# Copied automatically from sub1 by rotate-subscription.ps1 — keeps users logged in
jwt_secret_key          = "COPY_FROM_SUB1_OR_LEAVE_FOR_SCRIPT"
upload_token_secret     = "COPY_FROM_SUB1_OR_LEAVE_FOR_SCRIPT"

api_image                 = "margemregsub2.azurecr.io/margem-api:1.0.0"
create_container_registry = true

min_replicas                      = 1
enable_key_vault_purge_protection = true
allowed_hosts                     = "[\"margem-prod-sub2-api.azurecontainerapps.io\"]"
cors_origins                      = "[\"https://margem.app\"]"
