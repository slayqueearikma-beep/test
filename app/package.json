{
  "name": "scad-api",
  "version": "1.0.0",
  "description": "Secure Cloud-Native Application Delivery sample API for the SCAD DevSecOps platform.",
  "type": "module",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "c8 node --test",
    "test:coverage:check": "c8 check-coverage --lines 70"
  },
  "keywords": [
    "devsecops",
    "cloud",
    "azure",
    "container-apps",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^10.1.3",
    "eslint": "^10.6.0"
  },
  "c8": {
    "check-coverage": true,
    "lines": 70,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "test/**"
    ],
    "reporter": [
      "text",
      "json-summary"
    ]
  }
}
