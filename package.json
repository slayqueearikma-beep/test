{
  "name": "scad",
  "private": true,
  "description": "SCAD DevSecOps platform workspace scripts",
  "scripts": {
    "start": "npm --prefix app start",
    "test": "npm --prefix app test",
    "lint": "npm --prefix app run lint",
    "deploy": "node scripts/deploy.mjs",
    "deploy:azure": "node scripts/deploy-azure.mjs",
    "deploy:docker": "node scripts/deploy-docker.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:logs": "docker compose logs -f scad-api",
    "docker:ps": "docker compose ps",
    "docker:verify": "node scripts/verify-docker.mjs"
  }
}
