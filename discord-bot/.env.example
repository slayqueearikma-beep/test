# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_discord_bot_token

# Comma-separated Discord numeric user IDs allowed to run commands.
# Enable Discord Developer Mode, right-click user, Copy User ID.
DISCORD_ALLOWED_USER_IDS=123456789012345678,234567890123456789

# Optional. If set, slash commands sync only to this guild for faster testing.
DISCORD_GUILD_ID=

# Azure VM to control.
AZURE_RESOURCE_GROUP=rg-superior-rpg-prod
AZURE_VM_NAME=vm-superior-rpg-prod

# Optional display address printed by /startlab and /statuslab.
MINECRAFT_SERVER_ADDRESS=51.12.88.101:25565
