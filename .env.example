# Create a bot in the Discord Developer Portal, copy its token, and set it here.
DISCORD_TOKEN=replace-me

# Optional: set this to a single server ID while developing for faster slash-command sync.
# GUILD_ID=123456789012345678

# Optional: override where tournament data is stored.
# DATABASE_PATH=data/tournaments.db

# Optional: set to false if you want to sync slash commands manually.
# AUTO_SYNC_COMMANDS=true
